SECRET_KEY=troque-por-uma-chave-grande-e-aleatoria
DEBUG=True

# Fora do Docker (no Docker o docker-compose já define esses dois)
DATABASE_URL=sqlite:///db.sqlite3
CELERY_URL=redis://localhost:6379/0

# Gmail: use uma "senha de app" (myaccount.google.com/apppasswords), não a senha da conta.
# Deixe EMAIL_HOST_USER vazio para ver os emails no terminal em vez de enviar.
EMAIL_HOST_USER=seuemail@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
DEFAULT_FROM_EMAIL=TechBird <seuemail@gmail.com>
